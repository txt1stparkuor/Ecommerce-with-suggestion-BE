# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env (local) or set as server/CI environment vars.
# ============================================================

# --- Spring Profile ---
# dev = local, prod = production server
SPRING_PROFILES_ACTIVE=

# --- Database ---
DB_NAME=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Docker port mappings (dev only) ---
SPRING_LOCAL_PORT=8080
MYSQL_LOCAL_PORT=3307

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT ---
JWT_SECRET=

# --- Mail ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Frontend URL ---
FRONTEND_URL=

# --- Python AI Service ---
PYTHON_API_URL=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Production extras ---
# SERVER_PORT=8080